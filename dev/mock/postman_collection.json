{
  "info": {
    "name": "EDAM API (v3.1)",
    "description": "企业全格式数字资产防泄密系统 - 基于 openapi.yaml 自动生成",
    "version": "3.1.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4010",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "登录",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_no\": \"SA0001\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.response.code === 200) {",
                "  const json = pm.response.json();",
                "  pm.collectionVariables.set('token', json.access_token);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "获取当前用户",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "刷新 Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"rft_xxx\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Videos",
      "item": [
        {
          "name": "视频列表",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/videos?page=1&page_size=20",
              "host": ["{{baseUrl}}"],
              "path": ["videos"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "获取播放 Token",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/playback/1/token", "host": ["{{baseUrl}}"], "path": ["playback", "1", "token"] }
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "文档列表",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/documents?page=1", "host": ["{{baseUrl}}"], "path": ["documents"] }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health/live", "host": ["{{baseUrl}}"], "path": ["health", "live"] }
          }
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health/ready", "host": ["{{baseUrl}}"], "path": ["health", "ready"] }
          }
        }
      ]
    }
  ]
}
