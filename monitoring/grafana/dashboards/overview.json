{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "EDAM - Overview",
  "panels": [
    {
      "type": "stat",
      "title": "总 QPS",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{application=\"edam-backend\"}[1m]))",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]} }
      }
    },
    {
      "type": "stat",
      "title": "错误率 (5xx)",
      "id": 2,
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{application=\"edam-backend\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"edam-backend\"}[5m]))",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 0.01},
            {"color": "red", "value": 0.05}
          ]}
        }
      }
    },
    {
      "type": "stat",
      "title": "P99 延迟",
      "id": 3,
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"edam-backend\"}[5m])) by (le))",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "stat",
      "title": "在线用户数",
      "id": 4,
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "redis_connected_clients",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "graph",
      "title": "QPS 趋势 (1h)",
      "id": 5,
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{application=\"edam-backend\"}[1m])) by (uri)",
        "legendFormat": "{{uri}}",
        "refId": "A"
      }]
    },
    {
      "type": "graph",
      "title": "延迟分布 (P50/P95/P99)",
      "id": 6,
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(http_server_requests_seconds_bucket{application=\"edam-backend\"}[5m])) by (le))", "legendFormat": "P50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"edam-backend\"}[5m])) by (le))", "legendFormat": "P95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"edam-backend\"}[5m])) by (le))", "legendFormat": "P99", "refId": "C" }
      ],
      "yaxes": [{ "format": "s" }]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 30,
  "tags": ["edam", "overview"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" }
}