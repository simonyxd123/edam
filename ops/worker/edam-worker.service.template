# ============================================================================
# EDAM Worker —— 视频转码流水线（裸机 / 非 K8s 部署）
#
# ⚠️ 这是**模板**，不是最终 unit —— 里面的 @占位符@ 由
#    ops/worker/install.sh 渲染成 /etc/systemd/system/edam-worker.service。
#    别直接 cp 这个文件到 /etc/systemd/system/（占位符渲染不出来）。
#
# 为什么需要这个 unit：
#   2026-10-28 出过一次用户可见故障 —— 视频点播放报
#   "网络异常，正在重试（1/3）… (HTTP 404)"。根因是 **Worker 进程跑不起来**
#   （手工 nohup 起的，没有进程守护），转码任务卡在 RabbitMQ 队列里没人消费。
#   K8s 侧有 Deployment + livenessProbe 自动重启，裸机侧什么都没有 ——
#   机器重启或进程被 OOM kill，队列就永远卡住，而用户看到的只是 404。
#
# 安装：sudo ./ops/worker/install.sh
# ============================================================================
[Unit]
Description=EDAM Worker (video transcode pipeline)
Documentation=@DOCS_URL@
After=network-online.target
Wants=network-online.target

# 崩溃保护：10 分钟内重启超过 5 次就停下来等人处理，
# 免得配置写错时无限重启刷爆日志、把真正的错误淹掉。
# （systemd >= 230 要求 StartLimit* 放在 [Unit] 段）
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
@USER_LINE@
@GROUP_LINE@
WorkingDirectory=@WORKING_DIR@

# 全部配置走环境变量文件（不入库、不进版本控制）
EnvironmentFile=/etc/edam/worker.env

# ⚠️ 必须关掉 stdout 缓冲：Python 在 stdout 不是终端时是**块缓冲**的，
#    不关的话 journalctl 里什么都看不到（要等 4KB 或进程退出才吐），
#    排查时会误以为"worker 根本没打日志"。structlog 走的就是 stdout。
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# 用 worker 自己的入口（按 HTTP_PORT 起 uvicorn）
ExecStart=@PYTHON_BIN@ -m edam_worker.main

# 进程挂了/被 OOM kill ⇒ 自动拉起。这是本次故障最关键的一条。
Restart=always
RestartSec=5

# 优雅停机：SIGTERM 后 uvicorn 会跑 lifespan 的关闭段
#（里面 await worker.stop() 关掉 RabbitMQ 消费），
# 给 30s 让它处理完手上的任务
KillSignal=SIGTERM
TimeoutStopSec=30

# 日志进 journald：journalctl -u edam-worker -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=edam-worker

# 资源限制（防止单个转码任务把机器吃干）
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
