# ============================================================================
# EDAM Worker 环境变量模板
#
# 用法：
#   sudo cp ops/worker/edam-worker.env.example /etc/edam/worker.env
#   sudo vi /etc/edam/worker.env     # 至少改 WORKER_TOKEN / 密钥 / 密码
#   chmod 600 /etc/edam/worker.env
#
# ⚠️ 这个文件里有共享密钥和密码，**不要提交到 git**。
#    仓库里只保留 .example 模板。
#
# 变量含义见 worker/src/edam_worker/config.py（所有变量都有默认值，
# 但默认值是"本地单机"口径 —— 部署到服务器上必须显式写清楚）。
# ============================================================================

# ---------- 运行时 ----------
LOG_LEVEL=INFO
# worker 自身的 HTTP 端口：健康探针 /health/worker 和 Prometheus 指标都在这上面
HTTP_PORT=8001
# Prometheus 指标端口（worker 内部 start_http_server 起的那个）
METRICS_PORT=9100
ENABLE_METRICS=true

# ---------- 后端回调地址 ----------
# worker 处理完任务要回调后端改 hls_status。注意后端有 context-path=/api/v1
BACKEND_BASE_URL=http://127.0.0.1:8092/api/v1

# ---------- RabbitMQ ----------
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=edam
RABBITMQ_PASSWORD=edampass
RABBITMQ_VHOST=/

# ---------- MinIO / S3 ----------
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_VIDEOS=edam-videos
MINIO_BUCKET_DOCS=edam-documents
MINIO_BUCKET_WATERMARKS=edam-watermarks

# ---------- FFmpeg ----------
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_THREADS=4

# ---------- HLS ----------
HLS_SEGMENT_DURATION=10
HLS_PLAYLIST_TYPE=vod

# ---------- 帧指纹 ----------
FINGERPRINT_KEYFRAME_INTERVAL=30

# ---------- 共享密钥 ----------
# worker → 后端回调时带的头 X-Worker-Token；后端会校验，
# **为空则后端一律拒绝回调**（表现就是转码做完了但 hls_status 一直不变）。
# 必须与后端的 edam.worker.token 一致。
WORKER_TOKEN=REPLACE_WITH_THE_SAME_VALUE_AS_BACKEND_EDAM_WORKER_TOKEN

# ---------- 运维接口 ----------
# 按 video_id 手工重触发 HLS 的接口，默认关闭。
# 打开时 OPS_TOKEN 也必须设，且同样要走后端鉴权。
OPS_ENABLED=false
OPS_TOKEN=

# ---------- 失败重试 ----------
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_BACKOFF_SEC=1.0
